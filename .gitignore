# Catatan lengkap .gitignore untuk laundry-app
# File ini melindungi file temporary, environment, dan artefak pengembangan lokal.

#-------------------------
# Operating System Files
#-------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

#-------------------------
# Environment Files
#-------------------------
# Jangan masukkan file konfigurasi lokal ke version control.
.env
.env.*
.phpunit.result.cache
.php-version

#-------------------------
# CodeIgniter 4 Runtime / Writable Files
#-------------------------
/writable/cache/*
!/writable/cache/index.html

/writable/logs/*
!/writable/logs/index.html

/writable/session/*
!/writable/session/index.html

/writable/uploads/*
!/writable/uploads/index.html

/writable/debugbar/*
!/writable/debugbar/index.html

# Jika ada direktori cache atau file runtime lain
/writable/*.log
/writable/*.cache

#-------------------------
# Test & Build Artefacts
#-------------------------
/tests/coverage*
/phpunit
/phpunit*.xml

# Jika menggunakan CodeIgniter tools build atau report
/build/

#-------------------------
# Composer Dependencies
#-------------------------
vendor/

#-------------------------
# Editor / IDE Files
#-------------------------
.idea/
*.iml
.vscode/

# NetBeans
/nbproject/
/nbactions.xml
/nb-configuration.xml
/.nb-gradle/

# Sublime Text
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project
.phpintel

# VS Code workspace storage
.history/

#-------------------------
# Node / JS Package Files
#-------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml

#-------------------------
# Miscellaneous
#-------------------------
*.log
*.cache
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Jangan abaikan file yang jelas perlu disimpan
!/.gitignore
